# ==============================================================================
# wBus Environment Configuration
# ==============================================================================

# Vercel Blob Storage (Server-Side / Client Fallback)
# ------------------------------------------------------------------------------
# In Vercel deployments, OIDC authentication is handled automatically if Blob store is connected.
# For local development or token-based authentication:
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Optional: Explicit Static API / CDN Base URL for static cache files
NEXT_PUBLIC_STATIC_API_URL=""

# Static Data Handling (Client-Side)
# ------------------------------------------------------------------------------
# - 'false': Use local files in the 'public/data' or '.cache' folder (dev)
# - 'true': Use Vercel Blob storage (production)
NEXT_PUBLIC_USE_REMOTE_STATIC_DATA="true"

# Public Data Portal API (apis.data.go.kr - Server-Side Only)
# ------------------------------------------------------------------------------
# Service key for apis.data.go.kr - used by Vercel API routes to fetch live bus GPS and arrival data.
# Multi-key load balancing / quota failover supported (comma-separated):
# DATA_GO_KR_SERVICE_KEYS="KEY1,KEY2,KEY3"
DATA_GO_KR_SERVICE_KEY="YOUR_KEY_HERE"

# Redis Shared Cache (Server-Side Only - Optional)
# ------------------------------------------------------------------------------
# Optional but recommended for high-performance cross-instance caching of real-time telemetry.
REDIS_URL="YOUR_REDIS_URL_HERE"
